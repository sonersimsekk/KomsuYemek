rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'fullName', 'age', 'gender', 'email', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() < 80
        && request.resource.data.age is int
        && request.resource.data.age >= 1
        && request.resource.data.age <= 120
        && request.resource.data.gender in ['erkek', 'kadın']
        && request.resource.data.email is string
        && request.auth.token.email != null
        && request.resource.data.email.lower() == request.auth.token.email
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() < 40;

      allow update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'meal', 'stock', 'price', 'deliveryFee', 'description', 'image',
          'sellerId', 'sellerName', 'createdAt'
        ])
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.meal is string
        && request.resource.data.meal.size() > 0
        && request.resource.data.meal.size() < 120
        && request.resource.data.stock is int
        && request.resource.data.stock >= 1
        && request.resource.data.stock <= 100
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price <= 100000
        && request.resource.data.deliveryFee is number
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.deliveryFee <= 10000
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.sellerName is string
        && request.resource.data.sellerName.size() > 0
        && request.resource.data.sellerName.size() < 80
        && request.resource.data.createdAt == request.time
        && request.resource.data.image == null;

      allow update: if signedIn()
        && request.auth.uid != resource.data.sellerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && resource.data.stock - request.resource.data.stock <= 100;

      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;

      match /comments/{userId} {
        allow read: if signedIn();

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['userId', 'user', 'text', 'rating', 'date', 'postId'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.postId == postId
          && request.resource.data.user is string
          && request.resource.data.user.size() > 0
          && request.resource.data.user.size() < 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.date is string
          && request.resource.data.date.size() < 40;

        allow update, delete: if false;
      }
    }

    match /orders/{orderId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'items', 'subtotal', 'deliveryTotal', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.deliveryTotal is number
        && request.resource.data.deliveryTotal >= 0
        && request.resource.data.total is number
        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.deliveryTotal
        && request.resource.data.status == 'alındı'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
